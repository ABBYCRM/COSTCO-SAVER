# COSTCO-SAVER runtime configuration
#
# Web on DigitalOcean App Platform uses same-origin API calls, so VITE_API_BASE_URL
# may remain empty. Capacitor/Codemagic builds must point this at the deployed API.

VITE_API_BASE_URL=

# Server-only PostgreSQL URL. DigitalOcean App Platform injects this from the
# attached PostgreSQL database as a bindable runtime variable.
DATABASE_URL=
DATABASE_PRIVATE_URL=

# Server-only signing secret for access tokens. Minimum 32 characters.
JWT_SECRET=

# Optional database pool tuning.
DB_POOL_MAX=12

# Brand display only.
VITE_BRAND_RETAILER_NAME=Costco
