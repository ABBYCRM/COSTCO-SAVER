# COSTCO-SAVER — environment variables.
# Copy to .env.local and fill in.

# Supabase project URL and anon key. The anon key is safe to ship in the
# client bundle; the SERVICE role key MUST stay server-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Brand
VITE_BRAND_RETAILER_NAME=Costco

# Sentry / error tracking
VITE_SENTRY_DSN=

# Supabase service role key (server only — never commit, never import in client code).
# Used by Edge Functions, Codemagic, and the operator's admin scripts.
SUPABASE_SERVICE_ROLE_KEY=
